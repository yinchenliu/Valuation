{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "STE Plain",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py",
            "timeout": 15,
            "statusMessage": "Checking the unit's file scope"
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe ${CLAUDE_PROJECT_DIR}/.claude/hooks/seal_baseline.py",
            "timeout": 15,
            "statusMessage": "Snapshotting the orchestrator's records"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe ${CLAUDE_PROJECT_DIR}/.claude/hooks/seal_check.py",
            "timeout": 30,
            "statusMessage": "Checking the seal"
          }
        ]
      }
    ]
  }
}
