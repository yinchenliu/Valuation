# Copy this file to `.env` in the project root and fill in what you need.
#
#   cp .env.example .env
#
# `.env` is gitignored. config.py loads it at import time with override=True,
# so values here take precedence over system environment variables.


# ---------------------------------------------------------------------------
# PDF extraction (choose one provider)
# ---------------------------------------------------------------------------

# Google Gemini — the default extraction provider (cli.py --provider gemini).
# The same key also drives the agentic loop when AGENT_PROVIDER=gemini.
GEMINI_API_KEY=

# Anthropic Claude — used with `--provider claude`, and by the agentic
# orchestration loop by default. See the two auth options below.


# ---------------------------------------------------------------------------
# Claude auth — pick ONE of the two blocks
# ---------------------------------------------------------------------------

# Option A: first-party Anthropic API.
# Keys look like sk-ant-...  Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...


# Option B: Claude on Google Cloud (Vertex AI).
#
# IMPORTANT: Vertex has NO api_key parameter. It authenticates with Google
# credentials, so an Anthropic-style key string is not what it wants.
#
# Work out which of these you actually have:
#   AIza...      -> a Google AI Studio key for GEMINI, not Claude.
#                   Put it in GEMINI_API_KEY above; it will not work here.
#   a .json file -> a service account. Use GOOGLE_APPLICATION_CREDENTIALS.
#   ya29...      -> a short-lived OAuth access token (~1 hour).
#                   Use CLAUDE_VERTEX_ACCESS_TOKEN; refresh it when it expires.
#   none of these-> run: gcloud auth application-default login
#
# Setup:
#   1. pip install "anthropic[vertex]"
#   2. Enable the Vertex AI API on the project
#   3. Enable the Claude model in Vertex AI Model Garden (accept its terms)
#   4. Authenticate using one of the options below
#
# CLAUDE_PROVIDER=vertex
# CLAUDE_VERTEX_PROJECT_ID=my-gcp-project-id
# CLAUDE_VERTEX_REGION=us-east5
#
# Region must be one where the model is served. `global` works for most
# current models; us-east5 and europe-west1 are common explicit choices.
#
# Pick ONE auth method:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# CLAUDE_VERTEX_ACCESS_TOKEN=ya29...


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Which model family orchestrates the agentic loop: claude (default) or gemini.
# Note this is a different question from CLAUDE_PROVIDER above, which only picks
# how Claude itself is reached (first-party API vs Vertex AI).
#
# Left unset, Claude is used — Gemini is picked automatically only when
# GEMINI_API_KEY is the sole credential configured, so adding a Gemini key for
# PDF extraction never silently reroutes a working agent run.
# AGENT_PROVIDER=gemini

# Model driving the agentic loop, per family. Defaults are claude-opus-5 and
# gemini-3.1-pro-preview (see DEFAULT_MODELS in agent/loop.py).
# On Vertex use the same bare Claude ID, with no provider prefix.
# CLAUDE_AGENT_MODEL=claude-sonnet-5
# GEMINI_AGENT_MODEL=gemini-3-flash-preview

# Where yfinance keeps its timezone cache. Defaults to ./.yf_cache. Only worth
# setting if the project directory is read-only.
# YF_CACHE_DIR=
